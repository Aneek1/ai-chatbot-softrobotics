# Copy to .env and fill in only what you use.
GOOGLE_API_KEY=
GEMINI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Stage-2 language-ID specialist: a file in models/ written by training/export.py. Empty keeps the OpenCC rule.
LANGID_SPECIALIST=
# Start in private mode: Ollama only, DuckDuckGo only, no chat history written.
PRIVATE_MODE=false
# Optional SOCKS5 proxy for private searches; socks5h sends the name lookup through the proxy too.
PRIVATE_PROXY=
# Normal-mode web search: google, duckduckgo or off.
WEB_SEARCH=google
GOOGLE_SEARCH_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Built frontend served by the API. Leave this key commented out: unset falls back to
# frontend/dist under the repository, and the API serves itself alone when that build is missing.
# The container sets it explicitly; see the Dockerfile in Task 3.
# FRONTEND_DIST=/app/frontend/dist
